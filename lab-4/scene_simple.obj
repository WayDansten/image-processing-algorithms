# Simple composition scene with multiple area lights (no textures)
# Convention: groups named "light_*" are emissive
mtllib scene_simple.mtl

# Floor (quad)
usemtl floor_gray
g floor
v -3 0 -3
v 3 0 -3
v 3 0 3
v -3 0 3
f 1 2 3
f 1 3 4

# Back wall
usemtl wall_back_blue
g wall_back
v -3 0 -3
v 3 0 -3
v 3 3 -3
v -3 3 -3
f 5 6 7
f 5 7 8

# Left wall
usemtl wall_left_green
g wall_left
v -3 0 3
v -3 0 -3
v -3 3 -3
v -3 3 3
f 9 10 11
f 9 11 12

# Right wall
usemtl wall_right_red
g wall_right
v 3 0 -3
v 3 0 3
v 3 3 3
v 3 3 -3
f 13 14 15
f 13 15 16

# Tall box (rectangular prism)
usemtl box_tall_yellow
g box_tall
v -1.2 0 0.6
v -0.2 0 0.6
v -0.2 0 1.6
v -1.2 0 1.6
v -1.2 1.8 0.6
v -0.2 1.8 0.6
v -0.2 1.8 1.6
v -1.2 1.8 1.6
f 17 18 19
f 17 19 20
f 21 22 23
f 21 23 24
f 17 18 22
f 17 22 21
f 18 19 23
f 18 23 22
f 19 20 24
f 19 24 23
f 20 17 21
f 20 21 24

# Short box (rectangular prism)
usemtl box_short_cyan
g box_short
v 0.6 0 0.2
v 1.6 0 0.2
v 1.6 0 1.0
v 0.6 0 1.0
v 0.6 0.9 0.2
v 1.6 0.9 0.2
v 1.6 0.9 1.0
v 0.6 0.9 1.0
f 25 26 27
f 25 27 28
f 29 30 31
f 29 31 32
f 25 26 30
f 25 30 29
f 26 27 31
f 26 31 30
f 27 28 32
f 27 32 31
f 28 25 29
f 28 29 32

# Pyramid (square base)
usemtl pyramid_white
g pyramid
v -0.4 0 -0.8
v 0.4 0 -0.8
v 0.4 0 -0.1
v -0.4 0 -0.1
v 0 0.9 -0.45
f 33 34 35
f 33 35 36
f 33 34 37
f 34 35 37
f 35 36 37
f 36 33 37

# Ceiling (quad)
usemtl floor_gray
g ceiling
v -3 3 -3
v 3 3 -3
v 3 3 3
v -3 3 3
f 38 39 40
f 38 40 41

# Area light 2: triangular emitter on right wall
usemtl light_tri_warm
g light_tri
v 2.800000 1.440000 -0.426667
v 2.800000 2.560000 -0.986667
v 2.800000 2.000000 0.413333
f 42 43 44

# Ramp (triangular prism)
usemtl ramp_orange
g ramp
v -2.2 0 -0.2
v -1.2 0 -0.2
v -1.2 0 0.6
v -2.2 0 0.6
v -1.2 0.8 0.6
v -2.2 0.8 0.6
f 45 46 47
f 45 47 48
f 48 47 49
f 48 49 50
f 45 46 49
f 45 49 50
f 45 48 50
f 46 47 49

# Small cube near front-right
usemtl box_small_magenta
g box_small
v 1.1 0 -1.0
v 1.6 0 -1.0
v 1.6 0 -0.5
v 1.1 0 -0.5
v 1.1 0.5 -1.0
v 1.6 0.5 -1.0
v 1.6 0.5 -0.5
v 1.1 0.5 -0.5
f 51 52 53
f 51 53 54
f 55 56 57
f 55 57 58
f 51 52 56
f 51 56 55
f 52 53 57
f 52 57 56
f 53 54 58
f 53 58 57
f 54 51 55
f 54 55 58

# Former light_strip vertices kept to preserve indices
v -2.900000 1.050000 -0.450000
v -2.900000 1.050000 0.450000
v -2.900000 1.950000 0.450000
v -2.900000 1.950000 -0.450000

